{
  "name": "ver-para-crer",
  "version": "1.0.0",
  "private": true,
  "description": "VER PARA CRER — motion factory (Remotion)",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "score": "node --experimental-strip-types scripts/vpc-001-score.mjs",
    "render:v": "remotion render src/index.ts VPC001-Vertical out/vpc-001/ver-para-crer-ep01-vertical.mp4 --props={\"audio\":\"mix\"} --codec=h264 --crf=16 --audio-bitrate=320k",
    "render:h": "remotion render src/index.ts VPC001-Horizontal out/vpc-001/ver-para-crer-ep01-horizontal.mp4 --props={\"audio\":\"mix\"} --codec=h264 --crf=16 --audio-bitrate=320k"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@remotion/cli": "^4.0.534",
    "@remotion/fonts": "^4.0.534",
    "@remotion/media": "^4.0.534",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.534"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "typescript": "^5.6.3"
  }
}
